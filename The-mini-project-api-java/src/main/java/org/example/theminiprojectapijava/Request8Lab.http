### ==============================================================================
### ЛАБОРАТОРНА РОБОТА №8: Отримання та валідація JWT-токена
### Користувачі для тестування:
### - admin:admin123     (ROLE_ADMIN)
### - manager:manager123 (ROLE_MANAGER)
### - user:user123       (ROLE_USER)
### ==============================================================================

### 1. Логін адміністратора (ADMIN) -> Отримання JWT-токена (200 OK)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

> {%
    client.test("Login ADMIN successful", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.token !== undefined, "Token should be present in response");
        // Зберігаємо токен у глобальну змінну клієнта
        client.global.set("jwt_token", response.body.token);
    });
%}

### 2. Логін менеджера (MANAGER) -> Отримання JWT-токена (200 OK)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "manager",
  "password": "manager123"
}

> {%
    client.test("Login MANAGER successful", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.token !== undefined, "Token should be present");
    });
%}

### 3. Логін користувача (USER) -> Отримання JWT-токена (200 OK)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "user",
  "password": "user123"
}

> {%
    client.test("Login USER successful", function() {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

### 4. Невірні облікові дані -> 401 Unauthorized
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "wrongpassword"
}

> {%
    client.test("Invalid credentials rejected", function() {
        client.assert(response.status === 401, "Expected 401 Unauthorized");
    });
%}

### 5. Доступ до захищеного маршруту за отриманим JWT-токеном (Bearer Token)
GET http://localhost:8080/api/items
Authorization: Bearer {{jwt_token}}
Accept: application/json

> {%
    client.test("Access protected route with JWT Bearer token", function() {
        client.assert(response.status === 200, "Expected 200 OK with Bearer token");
    });
%}
